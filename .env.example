# =============================================================================
# Silk Road storefront — environment variables
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# Create React App only exposes variables prefixed with REACT_APP_, and they
# are baked into the JavaScript bundle at build time — never put a secret here.
# =============================================================================

# Base URL of the Silk Road API, without a trailing slash.
# Required — the app shows an error screen if it is missing.
REACT_APP_BACKEND_URL=http://localhost:5005

# PostHog analytics. Optional: leave empty to disable tracking entirely.
# The project API key is public by design (it ships in the bundle); use a
# separate project for development so test events stay out of production.
REACT_APP_POSTHOG_KEY=
REACT_APP_POSTHOG_HOST=https://us.i.posthog.com
